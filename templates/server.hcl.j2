{{ ansible_managed | comment }}

server {
    enabled = true
    bootstrap_expect = {{ nomad_server_bootstrap_expect }}

    # Nomad only consults this block when the cluster bootstraps, at the first
    # leader election. On a running cluster it is ignored, so editing it here
    # and restarting the servers changes nothing; use
    # `nomad operator scheduler set-config` to move a live cluster.
    default_scheduler_config {
        scheduler_algorithm = "{{ nomad_scheduler_algorithm }}"

        preemption_config {
            batch_scheduler_enabled    = {{ nomad_batch_scheduler_enabled | string | lower }}
            system_scheduler_enabled   = {{ nomad_scheduler_enabled | string | lower }}
            service_scheduler_enabled  = {{ nomad_service_scheduler_enabled | string | lower }}
            sysbatch_scheduler_enabled = {{ nomad_sysbatch_scheduler_enabled | string | lower }}
        }
    }
}

limits {
    http_max_conns_per_client = 0
}
